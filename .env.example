# =====================================================================
# Data Intelligence Platform — settings template
#
# LOCAL USE: copy this file to ".env" (same folder) and fill in the values.
# ON RENDER: do NOT upload a .env file. Enter each value in Render → your service →
#            Environment. Step-by-step help: docs/ENVIRONMENT_VARIABLES_GUIDE.md
# Never commit a real .env file — it is excluded by .gitignore.
# Values shown after "Example:" are FAKE examples, not real settings.
# =====================================================================

# --- DATABASE (required) ----------------------------------------------
# Neon → your project → Connect → (Connection pooling ON) → copy the string.  KEEP SECRET.
# Example: postgresql://USER:PASSWORD@ep-example-123456-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- SECURITY (required in production) ---------------------------------
# A long random value (40+ characters). On Render use the "Generate" button.  KEEP SECRET.
SECRET_KEY=
APP_ENV=development                 # production on Render
APP_BASE_URL=http://localhost:5173  # on Render: https://<your-service>.onrender.com
COOKIE_SECURE=false                 # true on Render (https)
SESSION_DAYS=7
REGISTRATION_OPEN=true              # false = only existing users and ADMIN_EMAILS can sign up
ADMIN_EMAILS=                       # e-mail(s) that see the Admin page, comma-separated

# --- FILE STORAGE ---------------------------------------------------------
STORAGE_PROVIDER=local              # s3 on Render (cloud storage). local = this computer only
LOCAL_STORAGE_DIR=                  # local only; empty = ./.data/storage
# Cloud storage (Neon Object Storage: Neon → Connect → Storage tab → ".env" view gives the AWS_ lines)
S3_BUCKET=                          # the bucket name you created, e.g. dip-files
AWS_ENDPOINT_URL_S3=                # Example: https://br-example-123.storage.example.neon.tech
AWS_REGION=                         # Example: ap-southeast-1   (Cloudflare R2: auto)
AWS_ACCESS_KEY_ID=                  # KEEP SECRET
AWS_SECRET_ACCESS_KEY=              # KEEP SECRET
# (S3_ENDPOINT_URL / S3_REGION / S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY are accepted as alternative names.)

# --- LIMITS (protect the free plans) ---------------------------------------
MAX_UPLOAD_MB=50                    # per file; 20 recommended on Render free (512 MB memory)
MAX_FILES_PER_UPLOAD=30
STORAGE_QUOTA_MB=0                  # 0 = no limit. 4500 recommended with Neon Object Storage (5 GB free)
DATABASE_QUOTA_MB=1024              # used only for the Admin usage meter (Neon Free: 1 GB per project)
ANALYSIS_MAX_MINUTES=20             # analyses running longer are stopped and marked failed
JOB_WORKERS=1                       # background jobs at a time (1 keeps memory low)

# --- E-MAIL (optional) ------------------------------------------------------
# console = no e-mail is sent (locally the reset link is printed; in production use Admin → "Create reset link")
EMAIL_PROVIDER=console              # console | brevo | smtp (smtp does not work on Render free)
BREVO_API_KEY=                      # Brevo → SMTP & API → API keys.  KEEP SECRET.
EMAIL_FROM=                         # a sender address verified in Brevo

# --- OPTIONAL FEATURES ------------------------------------------------------
OCR_ENABLED=true                    # needs the free Tesseract program (not available on Render native)
URL_FETCH_ENABLED=true
AUTO_MIGRATE=true                   # apply new database migrations automatically at start-up
LOG_LEVEL=INFO
DB_POOL_SIZE=5
MAGIC_LINK_ENABLED=false
ANALYSIS_SYNC=false                 # tests only
AI_PROVIDER=none                    # none | openai_compatible (optional, never required)
# AI_BASE_URL=
# AI_MODEL=
# AI_API_KEY=
